# PolyTable 部署环境变量示例：复制为 .env 后逐项修改，不要把真实口令提交进仓库
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 初始口令后缀：用户初始口令 = 姓名拼音首字母 + 该后缀（如 陈明 → CM + 此后缀）
OPS_AUTH_PASSWORD_SUFFIX=change-me-suffix

# 登录 token 的 HMAC 签名密钥：≥32 位随机串（重启后登录态依赖它保持有效）
OPS_AUTH_TOKEN_SECRET=change-me-random-32-chars-or-longer

# 账户管理页（/ops/admin.html）管理员账号
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=change-me-admin-password
